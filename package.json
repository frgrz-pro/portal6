{
  "name": "portal6",
  "private": true,
  "description": "Portal6 — task runner du monorepo. Les scripts ETL restent en Python (venv WSL: ~/.venvs/portal6)",
  "scripts": {
    "scan": "$HOME/.venvs/portal6/bin/python plugin/etl/music/local/scan_library.py /mnt/m/music /mnt/m/radio /mnt/m/downloads --out data/music/library_scan.csv",
    "build:db": "$HOME/.venvs/portal6/bin/python plugin/etl/music/build_db.py",
    "db:stats": "$HOME/.venvs/portal6/bin/python plugin/etl/music/build_db.py --stats",
    "fingerprint": "$HOME/.venvs/portal6/bin/python plugin/etl/music/local/fingerprint_library.py",
    "places:inventory": "$HOME/.venvs/portal6/bin/python plugin/etl/places/inventory.py",
    "places:build": "$HOME/.venvs/portal6/bin/python plugin/etl/places/build_db.py",
    "places:stats": "$HOME/.venvs/portal6/bin/python plugin/etl/places/build_db.py --stats",
    "web:manifest": "$HOME/.venvs/portal6/bin/python apps/web/build_manifest.py",
    "web": "$HOME/.venvs/portal6/bin/python -m http.server 8712 --directory apps/web",
    "food": "$HOME/.venvs/portal6/bin/python apps/food/server.py",
    "trmnl:dashboard": "$HOME/.venvs/portal6/bin/python features/trmnl/data/build_dashboard.py",
    "trmnl:push": "echo y | docker run --rm -i --env-file .env -v \"$PWD/features/trmnl/plugins/dashboard:/plugin\" trmnl/trmnlp push"
  }
}
