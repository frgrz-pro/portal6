{% comment %} Ciel & Mer — demi-écran horizontal : lune + prochaine marée + golden hour. {% endcomment %}
<style>
  .cm-h { display: flex; gap: 14px; align-items: center; height: 100%; }
  .cm-h > div { flex: 1 1 0; }
  .cm-h .cm-sep { flex: 0 0 2px; background: black; align-self: stretch; }
</style>

<div class="view view--half_horizontal">
  <div class="layout">
    <div class="cm-h">
      <div style="flex: 0 0 auto;">
        <svg width="72" height="72" viewBox="0 0 92 92" aria-hidden="true">
          <circle cx="46" cy="46" r="40" fill="none" stroke="black" stroke-width="2"></circle>
          <path d="{{ moon.svg_path }}" fill="black"></path>
        </svg>
      </div>
      <div>
        <span class="value">{{ moon.illumination }}%</span>
        <span class="label label--small">{{ moon.phase }}</span>
      </div>
      <div class="cm-sep"></div>
      {% assign next_tide = tides | first %}
      <div>
        <span class="label">Prochaine marée</span>
        <span class="value value--large">{{ next_tide.time | default: '—' }}</span>
        <span class="label label--small">{{ next_tide.label }} {{ next_tide.day }}</span>
      </div>
      <div class="cm-sep"></div>
      <div>
        <span class="label">Golden hour</span>
        <span class="value value--small">{{ sun.golden_pm }}</span>
        <span class="label label--small">coucher {{ sun.sunset }}</span>
      </div>
    </div>
  </div>

  <div class="title_bar">
    <span class="title">Ciel &amp; Mer</span>
    <span class="instance">{{ spot }}</span>
  </div>
</div>
