{% comment %} Ciel & Mer — quadrant : le strict nécessaire (lune + prochaine marée). {% endcomment %}
<div class="view view--quadrant">
  <div class="layout">
    <div style="display: flex; gap: 10px; align-items: center; height: 100%;">
      <svg width="64" height="64" viewBox="0 0 92 92" aria-hidden="true">
        <circle cx="46" cy="46" r="40" fill="none" stroke="black" stroke-width="2"></circle>
        <path d="{{ moon.svg_path }}" fill="black"></path>
      </svg>
      {% assign next_tide = tides | first %}
      <div>
        <span class="value">{{ moon.illumination }}%</span>
        <span class="label label--small">{{ next_tide.label | default: 'Marée' }} {{ next_tide.time | default: '—' }}</span>
        <span class="label label--small">Coucher {{ sun.sunset }}</span>
      </div>
    </div>
  </div>

  <div class="title_bar">
    <span class="title">Ciel &amp; Mer</span>
  </div>
</div>
