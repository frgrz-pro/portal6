{% comment %}
  Agenda semaine — layout « full » (800 x 480, 1-bit).
  Données poussées par features/trmnl/data/build_agenda.py (stratégie webhook, 2 Ko max).
  Une colonne par jour ; le jour courant est en inverse vidéo.
{% endcomment %}
<style>
  .ag-week { display: flex; gap: 6px; height: 100%; align-items: stretch; }
  .ag-day { flex: 1 1 0; display: flex; flex-direction: column;
            border: 2px solid black; min-width: 0; }
  .ag-day__head { text-align: center; padding: 2px 0; border-bottom: 2px solid black; }
  .ag-day--today .ag-day__head { background: black; color: white; }
  .ag-day__body { flex: 1 1 auto; padding: 4px; display: flex;
                  flex-direction: column; gap: 5px; overflow: hidden; }
  .ag-event { line-height: 1.15; }
  .ag-event__title { display: block; word-break: break-word; }
  .ag-empty { display: block; text-align: center; opacity: 0.45; margin-top: 8px; }
</style>

<div class="view view--full">
  <div class="layout">
    <div class="ag-week">
      {% for day in days %}
        <div class="ag-day {% if day.today %}ag-day--today{% endif %}">
          <div class="ag-day__head">
            <span class="label label--small">{{ day.label }}</span>
          </div>
          <div class="ag-day__body">
            {% for event in day.events %}
              <div class="ag-event">
                <span class="label label--small">{{ event.time }}{% if event.cal %} · {{ event.cal }}{% endif %}</span>
                <span class="ag-event__title label label--small">{{ event.title }}</span>
              </div>
            {% else %}
              <span class="ag-empty label label--small">—</span>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="title_bar">
    <span class="title">Agenda semaine</span>
    <span class="instance">
      {{ count }} événements{% if hidden and hidden > 0 %} (+{{ hidden }} masqués){% endif %} · {{ generated_at }}
    </span>
  </div>
</div>
