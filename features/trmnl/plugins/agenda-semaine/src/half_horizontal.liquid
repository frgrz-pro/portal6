{% comment %} Agenda semaine — demi-écran : les 3 prochains jours seulement. {% endcomment %}
<style>
  .ag-h { display: flex; gap: 8px; height: 100%; }
  .ag-h__day { flex: 1 1 0; min-width: 0; border-left: 2px solid black; padding-left: 8px; }
  .ag-h__day:first-child { border-left: none; padding-left: 0; }
  .ag-h__line { display: block; word-break: break-word; line-height: 1.15; }
</style>

<div class="view view--half_horizontal">
  <div class="layout">
    <div class="ag-h">
      {% for day in days limit: 3 %}
        <div class="ag-h__day">
          <span class="label label--underline">{{ day.label }}</span>
          {% for event in day.events limit: 3 %}
            <span class="ag-h__line label label--small">{{ event.time }} {{ event.title }}</span>
          {% else %}
            <span class="ag-h__line label label--small">—</span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="title_bar">
    <span class="title">Agenda</span>
    <span class="instance">{{ generated_at }}</span>
  </div>
</div>
